{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "中医典籍文库",
  "version": "0.1.0",
  "identifier": "com.tcmlibrary.search",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "中医典籍文库",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data: http: https:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "../../../corpus/**/*"
    ]
  }
}
