{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "中医典籍文库",
  "version": "0.1.0",
  "identifier": "com.tcmlibrary.search",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "中医典籍文库",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data: http: https:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../../corpus/**/*"
    ],
    "shortDescription": "中医药智能典籍检索与阅读工作台",
    "longDescription": "面向中医药学者、临床医家与古籍爱好者的智能典籍检索与阅读平台，提供11维中医临床证治匹配与三层互文研读体验。",
    "copyright": "Copyright © 2026 TCM-Library-Search Contributors"
  }
}
